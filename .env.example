# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/titan-logistics

# NextAuth Configuration
# Local: http://localhost:3000
# Production (Vercel): https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Admin login (used when running npm run seed)
INITIAL_ADMIN_EMAIL=info@titan-llc.com
INITIAL_ADMIN_PASSWORD=your-strong-password

# Hostinger SMTP — email mailbox on Hostinger, domain DNS at GoDaddy
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@titan-llc.com
SMTP_PASSWORD=your-hostinger-email-password
SMTP_FROM=Titan Logistics <info@titan-llc.com>
NOTIFICATION_EMAIL=info@titan-llc.com

# Optional: protect /api/seed on production (?secret=...)
SEED_SECRET=change-this-seed-secret

# Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/avif
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Titan Logistics LLC
# Bump when replacing images in /public (forces browsers to fetch new files)
NEXT_PUBLIC_ASSET_VERSION=5
